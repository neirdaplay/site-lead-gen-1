# ==================================================================
# Variables d'environnement — a creer dans Netlify
#   Site settings > Environment variables
# Ce fichier est un MODELE. Ne jamais y mettre de vraie valeur,
# ne jamais versionner de fichier .env.
# ==================================================================

# --- Stockage des leads -------------------------------------------
# "blobs" (defaut) | "webhook" | "blobs,webhook"
STOCKAGE=blobs
# Nom du magasin Netlify Blobs (facultatif)
BLOBS_STORE=leads
# Utilise uniquement si STOCKAGE contient "webhook"
WEBHOOK_URL=
WEBHOOK_TOKEN=

# --- Notification Telegram ----------------------------------------
# Jeton donne par @BotFather
TELEGRAM_BOT_TOKEN=
# Identifiant du salon ou de la conversation
TELEGRAM_CHAT_ID=
# "true" pour etre aussi notifie des demandes NON qualifiees
TELEGRAM_NOTIFIER_NON_QUALIFIES=false
